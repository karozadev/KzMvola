# Copier ce fichier en ".env" à côté de docker-compose.yml sur le VPS,
# puis remplir les valeurs. Ce fichier ne doit jamais être commité rempli.

# Image complète poussée par la CI dans GitHub Container Registry.
# Doit correspondre au nom du repo GitHub en minuscules.
IMAGE=ghcr.io/karozadev/kzmvola

# Tag d'image à déployer (la CI pousse "latest" et le SHA du commit).
IMAGE_TAG=latest

# Port local (127.0.0.1 uniquement) sur lequel le conteneur est exposé.
# Doit correspondre au port utilisé dans le "proxy_pass" du Nginx du VPS
# (voir deploy/nginx-vps.conf.example).
APP_PORT=8080
