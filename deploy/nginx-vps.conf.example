# Template du reverse proxy Nginx à installer sur le VPS (hors conteneur).
#
# 1. Copier ce fichier vers /etc/nginx/sites-available/kzmvola.conf
# 2. Remplacer __DOMAIN__ par ton nom de domaine (ex: kzmvola.exemple.com)
# 3. Remplacer __APP_PORT__ par la même valeur que APP_PORT dans deploy/.env
# 4. Activer le site puis recharger Nginx :
#      sudo ln -s /etc/nginx/sites-available/kzmvola.conf /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
# 5. Générer le certificat TLS (réécrit automatiquement ce fichier avec le bloc HTTPS) :
#      sudo certbot --nginx -d __DOMAIN__

server {
    listen 80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:__APP_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
